{
  "name": "safeclick",
  "version": "0.1.0",
  "private": true,
  "description": "SAFECLICK - détection accessible des arnaques numériques",
  "workspaces": [
    "apps/web",
    "apps/mobile",
    "packages/shared"
  ],
  "engines": {
    "node": ">=22.13.0 <27.0.0",
    "npm": ">=11.0.0"
  },
  "overrides": {
    "minimatch": "11.0.9"
  },
  "scripts": {
    "web:dev": "npm run dev -w @safeclick/web",
    "web:build": "npm run build -w @safeclick/web",
    "mobile:start": "npm run start -w @safeclick/mobile",
    "api:dev": ".\\.venv\\Scripts\\python -m uvicorn app.main:app --reload --app-dir services/api",
    "api:test": ".\\.venv\\Scripts\\python -m pytest services/api/tests -v",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "license": "UNLICENSED"
}
