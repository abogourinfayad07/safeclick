# ============================================================
# SAFECLICK - variables d'environnement (EXEMPLE, aucun secret réel)
# Copier : Copy-Item .env.example .env
# ============================================================

ENVIRONMENT=development
SITE_URL=http://localhost:3000
API_URL=http://localhost:8000
API_V1_PREFIX=/api/v1

# ---------- Base de données ----------
# SQLite par défaut en développement (Docker absent sur la machine actuelle).
# En production avec Docker/PostgreSQL :
# DATABASE_URL=postgresql+psycopg://safeclick:changez_moi@localhost:5432/safeclick
DATABASE_URL=sqlite:///./data/safeclick.db

POSTGRES_USER=safeclick
POSTGRES_PASSWORD=changez_moi
POSTGRES_DB=safeclick

# ---------- Cache / files d'attente (optionnel en dev) ----------
REDIS_URL=redis://localhost:6379/0

# ---------- Sécurité ----------
# À remplacer par une valeur aléatoire (ex: python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=remplacez_par_une_valeur_aleatoire_longue
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
RATE_LIMIT_PER_MINUTE=60

# ---------- Réputation externe (OPTIONNEL, vide = désactivé) ----------
# Aucune clé payante n'est requise pour le MVP.
VIRUSTOTAL_API_KEY=
URLHAUS_API_KEY=

# ---------- Email ----------
# console = les liens de vérification sont affichés dans les logs serveur (développement uniquement)
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=ne-pas-repondre@safeclick.local
